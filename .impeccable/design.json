  "narrative": {
    "northStar": "FlowSight on the small display",
    "overview": "The implemented interface extends the FlowSight desktop visual family onto a small physical display. A dark slate canvas, pale type and a clear teal action keep the timer dominant. Compact controls use plain Spanish labels and visible state feedback.\n\nThe native surface has a fixed landscape frame. Hierarchy comes from type size, spacing and tonal separation; screen changes are immediate, with no decorative motion.",
    "keyCharacteristics": [
      "A dominant clock with quieter mode, session count and status text.",
      "Teal actions and selected modes, supported by explicit wording.",
      "Rounded controls with visible pressed and disabled states."
    ],
    "rules": [
      {
        "name": "The Written State Rule",
        "body": "Color complements the mode, status and action label; it does not replace them.",
        "section": "colors"
      },
      {
        "name": "The Release Rule",
        "body": "Touching down changes the fill; release activates after a minimum 35 ms press. Sliding off cancels the action, and sliding back does not reactivate it.",
        "section": "components"
      },
      {
        "name": "The Protected Change Rule",
        "body": "Resetting or changing mode during a running or paused block requires an explicit on-device confirmation.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve FlowSight's dark slate and teal identity on this device.",
      "**Do** use explicit Spanish labels and keep each state understandable in words.",
      "**Do** retain touch targets at least 44 px tall and release-to-activate behavior.",
      "**Do** preserve the complete composition across both rendering strips."
    ],
    "donts": [
      "**Don't** reduce clock prominence to accommodate decorative content.",
      "**Don't** discard an active or paused block from touch controls without confirmation.",
      "**Don't** start the next focus or break block automatically on completion.",
      "**Don't** treat framebuffer captures as proof of physical LCD or touch alignment."
    ]
  }
